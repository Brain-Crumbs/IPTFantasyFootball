{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/driver-intake.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "intakeId",
    "projectRoot",
    "profileHash",
    "sourceHash",
    "source",
    "issueNumber",
    "issueUrl",
    "task",
    "diagnostics",
    "sessionId"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.driver-intake"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "intakeId": {
      "type": "string",
      "minLength": 1
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "profileHash": {
      "type": "string",
      "minLength": 1
    },
    "sourceHash": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "issueNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "issueUrl": {
      "oneOf": [{"type":"string","minLength":1},{"type":"null"}]
    },
    "task": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sessionId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
