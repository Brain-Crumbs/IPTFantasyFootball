{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/local-agent-result.schema.json",
  "title": "Local/manual agent result envelope v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "packetId",
        "providerId",
        "taskId",
        "role",
        "revisionIdentity",
        "runId",
        "actorId",
        "contextIdentity",
        "inputIdentity",
        "status",
        "result"
      ],
      "properties": {
        "schemaId": {
          "const": "ipt.local-agent-result"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "packetId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerId": {
          "const": "local-manual-agent"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "role": {
          "enum": [
            "Developer",
            "QA",
            "Architect",
            "UAT/Product",
            "MergeController"
          ]
        },
        "revisionIdentity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "contextIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "COMPLETED"
        },
        "result": {
          "$ref": "#/$defs/agentResult"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "packetId",
        "providerId",
        "taskId",
        "role",
        "revisionIdentity",
        "runId",
        "actorId",
        "contextIdentity",
        "inputIdentity",
        "status",
        "error"
      ],
      "properties": {
        "schemaId": {
          "const": "ipt.local-agent-result"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "packetId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerId": {
          "const": "local-manual-agent"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "role": {
          "enum": [
            "Developer",
            "QA",
            "Architect",
            "UAT/Product",
            "MergeController"
          ]
        },
        "revisionIdentity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "contextIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "CANCELLED"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "packetId",
        "providerId",
        "taskId",
        "role",
        "revisionIdentity",
        "runId",
        "actorId",
        "contextIdentity",
        "inputIdentity",
        "status",
        "error"
      ],
      "properties": {
        "schemaId": {
          "const": "ipt.local-agent-result"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "packetId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerId": {
          "const": "local-manual-agent"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "role": {
          "enum": [
            "Developer",
            "QA",
            "Architect",
            "UAT/Product",
            "MergeController"
          ]
        },
        "revisionIdentity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "contextIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputIdentity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "ERROR"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message",
            "recoverable"
          ],
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
            },
            "recoverable": {
              "const": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "agentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "taskId",
        "role",
        "revisionIdentity",
        "runId",
        "outcome",
        "details",
        "findings",
        "evidenceRefs",
        "occurredAt"
      ],
      "properties": {
        "providerId": {
          "const": "local-manual-agent"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "role": {
          "enum": [
            "Developer",
            "QA",
            "Architect",
            "UAT/Product",
            "MergeController"
          ]
        },
        "revisionIdentity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "details": {
          "type": "object"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "findingId",
              "severity",
              "observed",
              "expected"
            ],
            "properties": {
              "findingId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              },
              "severity": {
                "enum": [
                  "INFO",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "observed": {
                "type": "string",
                "pattern": "\\S"
              },
              "expected": {
                "type": "string",
                "pattern": "\\S"
              },
              "requirementRef": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              },
              "contractRef": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              },
              "remediation": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              }
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "T"
        },
        "nonPass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "remediation"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
            },
            "remediation": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
            },
            "blockingPrerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "FAIL",
                  "BLOCKED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "nonPass"
            ]
          }
        }
      ]
    }
  }
}
