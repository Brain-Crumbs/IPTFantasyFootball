{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/merge-evidence.schema.json",
  "title": "Merge Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "evidenceId",
    "taskId",
    "revisionIdentity",
    "pullRequestNumber",
    "mergeCommitSha",
    "policyDecisionReference",
    "recordedAt"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.merge-evidence"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "revisionIdentity": {
      "type": "string",
      "minLength": 1
    },
    "pullRequestNumber": {
      "type": "integer",
      "minimum": 1
    },
    "mergeCommitSha": {
      "type": "string",
      "minLength": 1
    },
    "policyDecisionReference": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
