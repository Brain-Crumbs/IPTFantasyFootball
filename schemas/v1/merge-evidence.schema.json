{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/merge-evidence.schema.json",
  "title": "Merge Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "evidenceId",
    "taskId",
    "revisionIdentity",
    "pullRequestNumber",
    "mergeCommitSha",
    "policyDecisionReference",
    "recordedAt"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.merge-evidence"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "revisionIdentity": {
      "type": "string",
      "minLength": 1
    },
    "pullRequestNumber": {
      "type": "integer",
      "minimum": 1
    },
    "mergeCommitSha": {
      "type": "string",
      "minLength": 1
    },
    "policyDecisionReference": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "assignmentLockAtMerge": {
      "description": "The assignment-lock identity active at the moment this confirmed merge was recorded, or null if none was active. Persisted so a later resume (a different call, possibly a different process) releases only the lock tied to *this* merge attempt, never whatever lock happens to be active at resume time.",
      "type": ["object", "null"],
      "properties": {
        "lockId": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "canonicalBranch": { "type": "string", "minLength": 1 }
      },
      "required": ["lockId", "ownerId", "runId", "canonicalBranch"],
      "additionalProperties": false
    }
  }
}
