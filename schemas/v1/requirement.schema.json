{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/requirement.schema.json",
  "title": "Requirement Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "requirementId",
    "taskId",
    "statement",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.requirement"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}-R[0-9]+$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
