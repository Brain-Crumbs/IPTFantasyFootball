{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/review-result.schema.json",
  "title": "Review Result and Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "reviewId",
    "taskId",
    "revisionIdentity",
    "role",
    "outcome",
    "findings",
    "evidenceRefs",
    "recordedAt"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.review-result"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "revisionIdentity": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "Developer",
        "QA",
        "Architect",
        "UAT/Product",
        "MergeController"
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "severity",
          "observed",
          "expected"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "requirementRef": {
            "type": "string",
            "minLength": 1
          },
          "contractRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
