{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/task.schema.json",
  "title": "Task Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "taskId",
    "title",
    "objective",
    "inScope",
    "outOfScope",
    "dependencies",
    "canonicalBranch",
    "allowedPaths",
    "requirements",
    "acceptanceCriteria",
    "validationPlan",
    "affectedContracts",
    "requiredReviewRoles"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.task"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "inScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "canonicalBranch": {
      "type": "string",
      "minLength": 1
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3,}-R[0-9]+$"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affectedContracts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredReviewRoles": {
      "type": "array",
      "items": {
        "enum": [
          "Developer",
          "QA",
          "Architect",
          "UAT/Product",
          "MergeController"
        ]
      },
      "uniqueItems": true
    }
  }
}
