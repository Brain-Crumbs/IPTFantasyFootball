{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iptfantasyfootball.dev/schemas/v1/validation-evidence.schema.json",
  "title": "Validation Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "evidenceId",
    "taskId",
    "revisionIdentity",
    "validatorId",
    "outcome",
    "checks",
    "recordedAt"
  ],
  "properties": {
    "schemaId": {
      "const": "ipt.validation-evidence"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "revisionIdentity": {
      "type": "string",
      "minLength": 1
    },
    "validatorId": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "outcome"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "details": {
            "type": "string"
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
